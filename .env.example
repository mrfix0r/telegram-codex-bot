# Файл с токеном. Сам TELEGRAM_BOT_TOKEN хранится отдельно в этом секрете.
BOT_SECRET_FILE=./.secrets/telegram.env

# Узнать свой ID можно у @userinfobot. Несколько ID разделяются запятыми.
TELEGRAM_OWNER_IDS=123456789

# Необязательно: ограничить работу конкретными chat_id.
TELEGRAM_ALLOWED_CHAT_IDS=

BOT_DATA_DIR=./data
BOT_POLL_TIMEOUT=30
BOT_LOG_LEVEL=INFO

# Интеграция с локальным Codex App Server.
BOT_CODEX_ENABLED=true
BOT_CODEX_EXECUTABLE=codex
BOT_CODEX_WORKSPACE=.
# Пустое значение использует модель из настроек Codex.
BOT_CODEX_MODEL=
BOT_CODEX_APPROVAL_POLICY=unlessTrusted
BOT_CODEX_REQUEST_TIMEOUT=30
